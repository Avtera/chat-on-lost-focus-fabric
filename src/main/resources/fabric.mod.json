{
  "schemaVersion": 1,
  "id": "chatonlostfocus",
  "version": "${version}",
  "name": "Chat On Lost Focus",
  "description": "This mod replaces the default functionality of Minecraft to open chat instead of menu when the window is not focused.",
  "authors": [
    "atikiNBTW"
    "Avtera"
  ],
  "contact": {
    "homepage": "https://github.com/Avtera/chat-on-lost-focus-fabric",
    "sources": "https://github.com/Avtera/chat-on-lost-focus-fabric"
  },
  "license": "The MIT License",
  "icon": "assets/chatonlostfocus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.atikinbtw.chatonlostfocus.ChatOnLostFocus"
    ],
    "modmenu": [
      "com.atikinbtw.chatonlostfocus.config.ModMenuConfig"
    ]
  },
  "mixins": [
    "chatonlostfocus.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
